# ── L5 候选注册表 ────────────────────────────────────────────────────────
class L5CandidateRegistry:
    """
    L5 候选策略注册表

    所有候选晋级实盘的策略必须先在此注册，
    经过影子实验验证后才能晋级。
    """
    def __init__(self):
        self._candidates = {}  # {strategy_name: {registered_at, promotion_trials, win_rate, auto_apply_to_live}}

    def register(self, strategy_name):
        if strategy_name not in self._candidates:
            self._candidates[strategy_name] = {
                "registered_at": None,
                "promotion_trials": 0,
                "win_rate": 0.0,
                "auto_apply_to_live": False  # 硬编码：默认禁止自动写入实盘
            }

    def is_promotion_ready(self, strategy_name):
        c = self._candidates.get(strategy_name, {})
        return (c.get("promotion_trials", 0) >= 5 and
                c.get("win_rate", 0) >= 0.55 and
                c.get("auto_apply_to_live") is False)  # 必须明确禁止自动写入

# ── L5 晋级闸门 ──────────────────────────────────────────────────────────
class L5PromotionGate:
    """
    L5 晋级闸门

    所有晋级必须满足以下条件：
    1. 影子实验次数 >= 5
    2. 胜率 >= 55%
    3. auto_apply_to_live == False（禁止自动写入）
    """
    def __init__(self):
        self._registry = L5CandidateRegistry()

    def try_promote(self, strategy_name):
        if self._registry.is_promotion_ready(strategy_name):
            return True  # 闸门通过（但实际写入仍需人工确认）
        return False

# 全局实例
_L5_REGISTRY = L5CandidateRegistry()
_L5_PROMOTION_GATE = L5PromotionGate()

