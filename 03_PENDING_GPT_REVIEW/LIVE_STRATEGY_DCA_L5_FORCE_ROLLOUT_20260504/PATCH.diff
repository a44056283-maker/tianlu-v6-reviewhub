    """记录所有强制操作到审计日志"""
    import datetime
    ts = datetime.datetime.now().isoformat()
    entry = f"{ts} | BOT={bot_id} | ACTION={action} | PAIR={pair} | REASON={reason} | CONFIRMED={confirmed_by}\n"
    with open(_FORCE_AUDIT_LOG, "a") as f:
        f.write(entry)

