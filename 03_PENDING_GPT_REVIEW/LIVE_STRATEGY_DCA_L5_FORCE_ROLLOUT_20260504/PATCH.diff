class ExitDecisionGate:
    """
    出场裁决闸门

    所有出场动作必须经过此门控：
    1. 不在 post_loss_observation 观察期内执行自学习收紧
    2. 不在 post_exit_continuation 状态下执行新入场
    3. 连续亏损收紧需门控确认（防止"卖在黎明前"）
    """
    def __init__(self):
        self._post_loss_observation = {}   # {pair: end_timestamp}
        self._post_exit_continuation = {} # {pair: end_timestamp}
        self._temp_thresh_override = {}   # {pair: threshold_override}
        self.OBSERVATION_WINDOW = 3600     # 1小时后恢复

    def is_in_observation(self, pair):
        import time
        if pair not in self._post_loss_observation:
            return False
        return time.time() < self._post_loss_observation[pair]

    def record_loss(self, pair):
        import time
        self._post_loss_observation[pair] = time.time() + self.OBSERVATION_WINDOW

    def request_threshold_override(self, pair, proposed_thresh):
        """请求收紧止盈阈值，门控裁决是否批准"""
        if self.is_in_observation(pair):
            return False  # 拒绝：观察期内不允许收紧
        self._temp_thresh_override[pair] = proposed_thresh
        return True

    def get_threshold(self, pair, default):
        return self._temp_thresh_override.get(pair, default)

